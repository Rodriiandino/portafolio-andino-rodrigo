---
import { useTranslations } from '../../i18n/utils'
import Layout from '../../layouts/Layout.astro'
import projects_es from '../../data/projects_es.json'
import projects_en from '../../data/projects_en.json'
import convertTitleToURL from '../utils/convert_title_to_url'
import { IconCode, IconDemo } from '../../components/icons/icons'
import { truncate } from '../../lib/site.js'

const { title } = Astro.params
const { currentLocale = 'es' } = Astro
const t = useTranslations(currentLocale)

const project = (() => {
  const projects = currentLocale === 'es' ? projects_es : projects_en

  return projects.find(project => convertTitleToURL(project.title) === title)
})()

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/projects/**/*',
  { eager: true }
)

function getImagePath(fileName: string | undefined) {
  if (!fileName) return null

  let normalizedPath = fileName

  if (normalizedPath.startsWith('/projects/')) {
    normalizedPath = normalizedPath.substring('/projects/'.length)
  }

  const path = `/src/assets/projects/${normalizedPath}`

  const imageModule = images[path]

  if (!imageModule) {
    console.error(`Image not found: ${path}`)
    return null
  }

  return imageModule.default
}

const seoTitle = `${project.title} | Rodrigo Andino`

// Meta description: the project's own summary, cut to ~155 chars
const seoDescription = truncate(project.description, 155)
---

<Layout
  title={seoTitle}
  description={seoDescription}
  image={project.images[0].src}
>
  <main class='project__page' id='main-content'>
    <div class='back-button-container'>
      <a
        href={currentLocale === 'es' ? '/#projects' : '/en/#projects'}
        class='back-button'
      >
        <svg
          aria-hidden='true'
          focusable='false'
          xmlns='http://www.w3.org/2000/svg'
          fill='none'
          viewBox='0 0 24 24'
          stroke-width='2'
          stroke='currentColor'
          class='w-6 h-6'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18'></path>
        </svg>
        <span class='back-button__text'>{t('project.back')}</span>
      </a>
    </div>

    <div class='project__buttons'>
      <div class='buttons__container'>
        <button
          type='button'
          class='project__image-button'
          id='button-left'
          aria-label={t('project.prevImage')}
          aria-controls='my-gallery'
          ><svg
            aria-hidden='true'
            focusable='false'
            xmlns='http://www.w3.org/2000/svg'
            fill='none'
            viewBox='0 0 24 24'
            stroke-width='2'
            stroke='currentColor'
            class='w-6 h-6'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M6.75 15.75 3 12m0 0l3.75-3.75M3 12h18'></path>
          </svg>
        </button>
        <button
          type='button'
          class='project__image-button'
          id='button-right'
          aria-label={t('project.nextImage')}
          aria-controls='my-gallery'
          ><svg
            aria-hidden='true'
            focusable='false'
            xmlns='http://www.w3.org/2000/svg'
            fill='none'
            viewBox='0 0 24 24'
            stroke-width='2'
            stroke='currentColor'
            class='w-6 h-6'
          >
            <path
              stroke-linecap='round'
              stroke-linejoin='round'
              d='M17.25 8.25 21 12m0 0-3.75 3.75M21 12H3'></path>
          </svg>
        </button>
      </div>
      <p
        class='sr-only'
        id='image-status'
        role='status'
        data-template={t('project.imageStatus')}
      >
      </p>
    </div>
    <div class='project__image' id='my-gallery'>
      {
        project.images.map((image, index) => {
          const imgPath = getImagePath(image.src)
          return (
            <a
              href={imgPath.src}
              data-cropped='true'
              data-pswp-width={imgPath.width}
              data-pswp-height={imgPath.height}
              class={index === 0 ? 'gallery-item active' : 'gallery-item'}
              style={index === 0 ? '' : 'display: none;'}
            >
              <img
                src={imgPath.src}
                alt={image.alt}
                id={`img-${index}`}
                loading={index === 0 ? 'eager' : 'lazy'}
                decoding='async'
              />
            </a>
          )
        })
      }
    </div>
    <div class='project__aside-container'>
      <button
        type='button'
        class='aside__move-top'
        aria-label={t('project.toggleDetails')}
        aria-expanded='false'
        aria-controls='project-aside'
      >
        <svg
          aria-hidden='true'
          focusable='false'
          xmlns='http://www.w3.org/2000/svg'
          fill='none'
          viewBox='0 0 24 24'
          stroke-width='2'
          stroke='currentColor'
          class='w-6 h-6'
        >
          <path
            stroke-linecap='round'
            stroke-linejoin='round'
            d='M3.75 9h16.5m-16.5 6.75h16.5'></path>
        </svg>
      </button>
      <aside class='project__aside' id='project-aside'>
        <div>
          <h1 class='aside__title' id='title'>{project.title}</h1>
          <p class='aside__description'>{project.description}</p>
        </div>

        <div>
          <h2 class='aside__title'>{t('project.learn')}</h2>
          {
            project.what_i_learned?.map(learn => (
              <p class='aside__learn'>{learn}</p>
            ))
          }
        </div>

        <table class='aside__table'>
          <tbody class='aside__tbody'>
            <tr class='aside__tr'>
              <th scope='row'>{t('project.characteristics')}</th>
              <td>{project.features}</td>
            </tr>
            <tr class='aside__tr'>
              <th scope='row'>{t('project.date')}</th>
              <td>{project.date}</td>
            </tr>
            <tr class='aside__tr'>
              <th scope='row'>{t('project.technologies')}</th>
              <td
                >{
                  project.technologies.map((tech, i) =>
                    i === project.technologies.length - 1 ? tech : `${tech}, `
                  )
                }</td
              >
            </tr>
            <tr class='aside__tr'>
              <th scope='row'>{t('project.state')}</th>
              <td>{project.status}</td>
            </tr>
            <tr class='aside__tr'>
              <th scope='row'>{t('project.deploy')}</th>
              <td>{project.deploy.page}</td>
            </tr>
          </tbody>
        </table>

        <footer class='aside__footer'>
          {
            project.github && (
              <a
                href={project.github}
                target='_blank'
                rel='noopener noreferrer'
                aria-label={`${t('aria.codeOf')} ${project.title} (${t('a11y.newTab')})`}
              >
                <IconCode /> {t('link.code')}
              </a>
            )
          }

          {
            project.deploy.demo && (
              <a
                href={project.deploy.demo}
                target='_blank'
                rel='noopener noreferrer'
                aria-label={`${t('aria.demoOf')} ${project.title} (${t('a11y.newTab')})`}
              >
                <IconDemo /> {t('link.demo')}
              </a>
            )
          }
        </footer>
      </aside>
    </div>
  </main>

  <script>
    import projects_es from '../../data/projects_es.json'
    import projects_en from '../../data/projects_en.json'

    const handleProjectLogic = () => {
      const $html = document.querySelector('html') as HTMLHtmlElement
      const $moveTop = document.querySelector(
        '.aside__move-top'
      ) as HTMLButtonElement
      const $asideContainer = document.querySelector(
        '.project__aside-container'
      ) as HTMLDivElement
      const $projectImage = document.querySelector(
        '.project__image'
      ) as HTMLDivElement
      const $buttonsContainer = document.querySelector(
        '.buttons__container'
      ) as HTMLDivElement
      const $buttonLeft = document.querySelector(
        '#button-left'
      ) as HTMLButtonElement
      const $buttonRight = document.querySelector(
        '#button-right'
      ) as HTMLButtonElement
      const $title = document.querySelector('#title') as HTMLHeadingElement
      const $imageStatus = document.querySelector(
        '#image-status'
      ) as HTMLParagraphElement | null

      if (
        !$html ||
        !$moveTop ||
        !$asideContainer ||
        !$projectImage ||
        !$buttonsContainer ||
        !$buttonLeft ||
        !$buttonRight ||
        !$title
      ) {
        return
      }

      const breakpoint = window.matchMedia('(max-width: 1100px)')
      let translate = 0
      let currentImg = 0

      const adjustAsideHeight = () => {
        if (window.innerWidth > 1100) return
        const windowHeight = window.innerHeight
        const asideHeight = $asideContainer.scrollHeight

        if (asideHeight > windowHeight) {
          $asideContainer.style.height = `100%`
          $asideContainer.style.overflowY = 'auto'
        } else {
          $asideContainer.style.maxHeight = 'none'
          $asideContainer.style.overflowY = 'hidden'
        }
      }

      const updateProjectImg = (def = true) => {
        if (def) {
          $projectImage.style.cursor = 'default'
          $projectImage.style.backdropFilter = 'none'
          const activeImg = $projectImage.querySelector(
            '.gallery-item.active img'
          )
          if (activeImg) {
            ;(activeImg as HTMLElement).style.filter = 'none'
          }
          $projectImage.style.userSelect = 'auto'
        } else {
          $projectImage.style.cursor = 'pointer'
          $projectImage.style.backdropFilter = 'saturate(100%) brightness(60%)'
          const activeImg = $projectImage.querySelector(
            '.gallery-item.active img'
          )
          if (activeImg) {
            ;(activeImg as HTMLElement).style.filter =
              'saturate(100%) brightness(60%)'
          }
          $projectImage.style.userSelect = 'none'
        }
      }

      // translate === 90 means the mobile details panel is open
      const syncExpanded = () => {
        $moveTop.setAttribute('aria-expanded', String(translate === 90))
      }

      const handleMoveTopClick = () => {
        if (translate == 0) {
          updateProjectImg(false)
          $asideContainer.style.transform = `translateY(${translate}%)`
          translate = 90
        } else {
          updateProjectImg()
          $asideContainer.style.transform = `translateY(${translate}%)`
          translate = 0
        }
        syncExpanded()
        adjustAsideHeight()
      }

      const handleProjectImageClick = () => {
        if (translate == 90) {
          updateProjectImg()
          $asideContainer.style.transform = `translateY(${translate}%)`
          translate = 0
        }
        syncExpanded()
        adjustAsideHeight()
      }

      // On mobile the collapsed panel sits off-screen: open it when keyboard
      // focus moves into it so the focused link is not hidden (WCAG 2.4.11)
      const handleAsideFocusIn = (event: FocusEvent) => {
        if (!breakpoint.matches || translate === 90) return
        if (event.target === $moveTop) return
        handleMoveTopClick()
      }

      const handleBreakpointChange = (e: MediaQueryListEvent) => {
        if (e.matches) {
          updateProjectImg()
          $asideContainer.style.transform = `translateY(90%)`
          translate = 0
        }
        syncExpanded()
        adjustAsideHeight()
      }

      const handleResize = () => {
        if (window.innerWidth > 1100) {
          updateProjectImg()
          $asideContainer.style.removeProperty('transform')
          $asideContainer.style.removeProperty('overflow-y')
          $asideContainer.style.removeProperty('height')
          $asideContainer.style.removeProperty('max-height')
          translate = 0
        }
        syncExpanded()
        adjustAsideHeight()
      }

      const currentLocale = $html.getAttribute('lang') as string
      const projects = currentLocale === 'es' ? projects_es : projects_en
      const project = projects.find(
        project => project.title === $title.textContent
      )

      if (!project) return

      const imgLength = project.images.length

      if (imgLength === 1) {
        $buttonsContainer.style.display = 'none'
      }

      const showImage = (index: number) => {
        currentImg = index
        const galleryItems = $projectImage.querySelectorAll('.gallery-item')
        galleryItems.forEach(item => {
          ;(item as HTMLElement).style.display = 'none'
          item.classList.remove('active')
        })

        const currentItem = galleryItems[currentImg]
        if (currentItem) {
          ;(currentItem as HTMLElement).style.display = ''
          currentItem.classList.add('active')
        }

        // Polite status so screen readers hear which image is now shown
        if ($imageStatus?.dataset.template) {
          $imageStatus.textContent = $imageStatus.dataset.template
            .replace('{current}', String(currentImg + 1))
            .replace('{total}', String(imgLength))
        }
      }

      const handleLeftClick = () => {
        showImage(currentImg === 0 ? imgLength - 1 : currentImg - 1)
      }

      const handleRightClick = () => {
        showImage(currentImg === imgLength - 1 ? 0 : currentImg + 1)
      }

      const cleanup = () => {
        $moveTop.removeEventListener('click', handleMoveTopClick)
        $asideContainer.removeEventListener('focusin', handleAsideFocusIn)
        $projectImage.removeEventListener('click', handleProjectImageClick)
        breakpoint.removeEventListener('change', handleBreakpointChange)
        window.removeEventListener('resize', handleResize)
        $buttonLeft.removeEventListener('click', handleLeftClick)
        $buttonRight.removeEventListener('click', handleRightClick)
      }

      cleanup()
      $moveTop.addEventListener('click', handleMoveTopClick)
      $asideContainer.addEventListener('focusin', handleAsideFocusIn)
      $projectImage.addEventListener('click', handleProjectImageClick)
      breakpoint.addEventListener('change', handleBreakpointChange)
      window.addEventListener('resize', handleResize)
      $buttonLeft.addEventListener('click', handleLeftClick)
      $buttonRight.addEventListener('click', handleRightClick)

      adjustAsideHeight()
    }

    document.addEventListener('DOMContentLoaded', handleProjectLogic)
    document.addEventListener('astro:page-load', handleProjectLogic)
    document.addEventListener('astro:before-preparation', () => {
      const cleanup = () => {
        const $moveTop = document.querySelector('.aside__move-top')
        const $projectImage = document.querySelector('.project__image')
        const $buttonLeft = document.querySelector('#button-left')
        const $buttonRight = document.querySelector('#button-right')

        if ($moveTop) $moveTop.replaceWith($moveTop.cloneNode(true))
        if ($projectImage)
          $projectImage.replaceWith($projectImage.cloneNode(true))
        if ($buttonLeft) $buttonLeft.replaceWith($buttonLeft.cloneNode(true))
        if ($buttonRight) $buttonRight.replaceWith($buttonRight.cloneNode(true))
      }
      cleanup()
    })
  </script>
  <style is:global>
    .project__page {
      position: relative;
      width: 100%;
      height: 100dvh;
    }

    .back-button-container {
      position: fixed;
      top: 1.5rem;
      left: 1.5rem;
      z-index: 900;
    }

    .back-button {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      padding: 0.5rem 1rem;
      background-color: var(--black);
      color: var(--white);
      border-radius: var(--border-radius);
      text-decoration: none;
      font-weight: 600;
      transition: all 0.3s ease;
      border: 1px solid var(--sky-blue);
    }

    .back-button:hover {
      background-color: var(--dark-blue);
      transform: translateX(-5px);
    }

    .back-button svg {
      width: 1.2rem;
      height: 1.2rem;
      color: var(--light-blue);
    }

    .project__image {
      position: fixed;
      inset: 0;
      height: 100%;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all 0.3s ease-in-out;
      z-index: 800;
    }

    .pswp__scroll-wrap {
      max-width: 100%;
      padding: 0;
    }

    .project__image img {
      max-width: 700px;
      max-height: fit-content;
      width: 100%;
      height: 100%;
      transform: translateX(-208.558px) translateY(0px) translateZ(0px);
      transition: all 0.3s ease-in-out;
      object-fit: contain;
      border-radius: 8px;
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.3);
    }

    .project__image img:hover {
      transform: translateX(-208.558px) translateY(0px) translateZ(0px)
        scale(1.02);
    }

    .project__buttons {
      z-index: 900;
      position: fixed;
      bottom: 1rem;
      right: 0;
      left: 0;
      display: flex;
      gap: 0.5rem;
      pointer-events: none;
    }

    .buttons__container {
      display: flex;
      gap: 1.5rem;
      pointer-events: all;
      background-color: var(--black);
      border-radius: var(--border-radius);
      padding: 0.4rem;
      margin: 0 auto;
      transform: translateX(-208.558px) translateY(0px) translateZ(0px);
    }

    .project__image-button {
      width: 2.3rem;
      height: 2.3rem;
      border-radius: 50%;
      background-color: var(--dark-blue);
      border: none;
      cursor: pointer;
      transition: all 0.3s ease-in-out;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .project__image-button svg {
      color: var(--light-background);
      width: 1.3rem;
      height: 1.3rem;
    }

    .project__image-button:hover {
      transform: scale(1.15);
      background-color: var(--dark-background);
    }

    .project__image-button:hover svg {
      color: var(--white);
    }

    .project__image .gallery-item {
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .project__image .gallery-item.active {
      display: flex;
    }

    .project__aside-container {
      position: absolute;
      inset: 0;
      display: flex;
      justify-content: flex-end;
      overflow-x: hidden;
      overflow-y: scroll;
    }

    .project__aside {
      z-index: 900;
      position: relative;
      width: 100%;
      max-width: 30%;
      min-width: 25rem;
      height: fit-content;
      min-height: 100%;
      padding: 2.3rem 2.6rem;
      background-color: var(--black);
      border-radius: var(--border-radius) 0 0 var(--border-radius);

      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 2rem;
    }

    .aside__move-top {
      z-index: 100;
      display: none;
      border: none;
      padding: 0;
      font: inherit;
    }

    .aside__move-top svg {
      color: var(--light-background);
      width: 1rem;
    }

    /* The bar is always --sky-blue; in the dark theme --light-background is
       almost white on it (1.1:1), so use the dark navy there (WCAG 1.4.11) */
    [data-theme='dark'] .aside__move-top svg {
      color: var(--dark-blue);
    }

    /* Theme-independent ring: the bar background never changes */
    .aside__move-top:focus-visible {
      outline: 3px solid #06283d;
      outline-offset: -3px;
    }

    .aside__title {
      font-size: var(--step-1);
      font-weight: 600;
      text-transform: uppercase;
      border-bottom: 5px solid var(--sky-blue);
      box-shadow: 0 6px 3px -5px var(--sky-blue);
      margin-bottom: 0.5rem;
    }

    .aside__description {
      font-size: var(--step--1);
      font-weight: 400;
    }

    .aside__learn {
      font-size: var(--step--1);
      font-weight: 400;
      color: var(--white);
      margin-bottom: 0.5rem;
    }

    .aside__table {
      width: 100%;
      border-collapse: collapse;
    }

    .aside__tbody {
      width: 100%;
    }

    .aside__tr {
      width: 100%;
      padding: 0.5rem 0;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      border-bottom: 3px solid var(--sky-blue);
    }

    .aside__tr th {
      font-size: var(--step--1);
      font-weight: 600;
      color: var(--light-blue);
      text-align: left;
      text-transform: capitalize;
    }

    .aside__tr td {
      font-size: var(--step--1);
      font-weight: 500;
      color: var(--white);
      text-align: right;
    }

    .aside__footer {
      padding: 0;
      width: 100%;
      display: flex;
      gap: 1rem;
    }

    .aside__footer a {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      color: var(--white);
      font-size: var(--step-0);
      font-weight: 600;
      text-decoration: none;
      transition: all 0.2s ease-in-out;
    }

    .aside__footer a:hover {
      color: var(--light-blue);
      text-decoration: underline;
    }

    .aside__footer a svg {
      color: var(--light-blue);
    }

    @media (max-width: 1100px) {
      .back-button-container {
        top: 1rem;
        left: 1rem;
      }

      .back-button {
        padding: 0.4rem 0.8rem;
        font-size: 0.9rem;
      }

      .project__buttons {
        bottom: 6.5rem;
        right: 0;
        left: 0;
        justify-content: center;
      }

      .buttons__container {
        transform: none;
      }

      .project__image {
        width: 100%;
        transition: all 0.3s ease-in-out;
      }

      .project__image img {
        height: fit-content;
        transform: none;
        transition: all 0.3s ease-in-out;
        margin: 0 auto;
      }

      .project__image img:hover {
        transform: scale(1.02);
      }

      .project__aside-container {
        position: fixed;
        inset: auto 0 0 0;
        width: 100%;
        transform: translateY(93%);
        height: fit-content;
        overflow: none;
        transition: all 0.3s ease-in-out;
        z-index: 900;
      }

      .project__aside-container:hover {
        transform: translateY(91%);
      }

      .project__aside {
        width: 100%;
        max-width: 100%;
        height: 100%;
        min-height: auto;
        padding: 1.3rem 1.6rem;
        border-radius: var(--border-radius) var(--border-radius) 0 0;
        overflow: auto;
      }

      .aside__move-top {
        z-index: 950;
        display: block;
        width: 100%;
        height: 1.3rem;
        position: absolute;
        top: 0;
        right: 0;
        font-size: var(--step-0);
        font-weight: 600;
        color: var(--black);
        background-color: var(--sky-blue);
        border-radius: var(--border-radius) var(--border-radius) 0 0;
        cursor: pointer;
        text-align: center;
        transition: all 0.3s ease-in-out;
        user-select: none;
      }

      .aside__move-top:hover {
        transform: scaleY(1.1);
        background-color: var(--light-blue);
      }

      .aside__move-top:active {
        transform: scaleY(1.2);
        background-color: var(--light-blue);
      }

      .aside__title {
        padding-top: 0.5rem;
      }
    }

    @media (max-width: 480px) {
      /* Visually hidden, still the link's accessible name */
      .back-button__text {
        position: absolute;
        width: 1px;
        height: 1px;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
      }

      .back-button {
        padding: 0.4rem;
      }

      .project__aside {
        padding: 1rem 1.3rem;
        min-width: fit-content;
      }

      .aside__tr td {
        font-size: var(--step--2);
      }

      .aside__footer a {
        font-size: var(--step--1);
      }
    }
  </style>
</Layout>
