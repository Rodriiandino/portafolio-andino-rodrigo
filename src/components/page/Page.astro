---
import Layout from '../../layouts/Layout.astro'
import Header from '../Header.astro'
import Bento from '../Bento.astro'
import Experience from '../Experience.astro'
import Projects from '../Projects/Projects.astro'
import Skills from '../Skills.astro'
import Contact from '../Contact.astro'
import Footer from '../Footer.astro'
import Nav from '../Nav.astro'

const { currentLocale = 'es' } = Astro

const locales = {
  es: {
    title: 'Rodrigo Andino | Tech Lead, Ingeniería de IA y sistemas RAG',
    description:
      'Rodrigo Andino, Licenciado en Informática y Tech Lead Full Stack. Arquitectura de software, IA y sistemas RAG con Next.js, TypeScript y Convex.'
  },
  en: {
    title: 'Rodrigo Andino | Tech Lead, AI Engineering & RAG Systems',
    description:
      'Rodrigo Andino, Computer Science graduate and Full Stack Tech Lead. Software architecture, AI and RAG systems with Next.js, TypeScript and Convex.'
  }
}
---

<Layout
  title={locales[currentLocale].title}
  description={locales[currentLocale].description}
>
  <Header />
  <main>
    <Bento />
    <Experience />
    <Projects />
    <Skills />
    <Contact />
  </main>
  <Nav />
  <Footer />
</Layout>
