---
import Layout from '../../layouts/Layout.astro'
import Header from '../Header.astro'
import Bento from '../Bento.astro'
import Experience from '../Experience.astro'
import Projects from '../Projects/Projects.astro'
import Skills from '../Skills.astro'
import Contact from '../Contact.astro'
import Footer from '../Footer.astro'
import Nav from '../Nav.astro'

const { currentLocale = 'es' } = Astro

const locales = {
  es: {
    title: 'Rodrigo Andino | Tech Lead y Desarrollador Full Stack',
    description:
      'Rodrigo Andino, Tech Lead en NotChatbot y desarrollador Full Stack con más de 4 años de experiencia en React, Next.js, TypeScript, Java y Spring Boot.'
  },
  en: {
    title: 'Rodrigo Andino | Tech Lead & Full Stack Developer',
    description:
      'Rodrigo Andino, Tech Lead at NotChatbot and Full Stack Developer with 4+ years of experience in React, Next.js, TypeScript, Java and Spring Boot.'
  }
}
---

<Layout
  title={locales[currentLocale].title}
  description={locales[currentLocale].description}
>
  <Header />
  <main>
    <Bento />
    <Experience />
    <Projects />
    <Skills />
    <Contact />
  </main>
  <Nav />
  <Footer />
</Layout>
