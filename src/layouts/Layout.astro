---
import { ClientRouter } from 'astro:transitions'
const { currentLocale = 'es' } = Astro
import SEO from '../components/SEO.astro'
// Only the latin subset of Onest is used (every rendered character falls in
// its unicode-range), so the @font-face is declared inline below instead of
// importing all 7 subsets from @fontsource-variable/onest/index.css. Inlining
// it and preloading the file lets the font start downloading with the HTML
// instead of after the stylesheet.
import onestLatin from '@fontsource-variable/onest/files/onest-latin-wght-normal.woff2?url'

interface Props {
  title: string
  description: string
  canonical?: string
  image?: string
}

const { title, description, canonical, image } = Astro.props

const fontFace = `@font-face{font-family:'Onest Variable';font-style:normal;font-display:swap;font-weight:100 900;src:url(${onestLatin}) format('woff2-variations');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}`
---

<html lang={currentLocale} data-theme='light'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <script is:inline>
      ;(function () {
        const storedTheme = localStorage.getItem('darkMode-portafolio-andino')
        const prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)'
        ).matches

        let theme = 'light'

        if (storedTheme === 'true' || (storedTheme === null && prefersDark)) {
          theme = 'dark'
          document.documentElement.classList.add('dark')
        }

        document.documentElement.setAttribute('data-theme', theme)

        // Tells the CSS that JS runs, so [data-reveal] content may start
        // hidden (without JS it is simply visible)
        document.documentElement.classList.add('js')

        // ClientRouter copies the incoming <html> attributes, which arrive as
        // the server sent them: without this, every navigation would drop
        // `js` (revealed content flickers) and reset the theme to light until
        // astro:page-load re-syncs it. Registered once per document.
        if (window.__rootSwapHook) return
        window.__rootSwapHook = true
        document.addEventListener('astro:before-swap', function (event) {
          const current = document.documentElement
          const incoming = event.newDocument.documentElement
          incoming.classList.add('js')
          incoming.classList.toggle('dark', current.classList.contains('dark'))
          incoming.setAttribute(
            'data-theme',
            current.getAttribute('data-theme') || 'light'
          )
        })
      })()
    </script>
    <script>
      // Toggle button + re-sync on every ClientRouter navigation. A module
      // script is deferred, so the pre-paint theme comes from the inline
      // script above
      import themeChange from '../components/dom/theme-change.js'
      import reveal from '../components/dom/reveal.js'
      themeChange()
      reveal()
    </script>
    <link
      rel='preload'
      href={onestLatin}
      as='font'
      type='font/woff2'
      crossorigin
    />
    <style is:inline set:html={fontFace} />
    <meta name='generator' content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      image={image}
    />
    <ClientRouter />
  </head>
  <body id='home'>
    <slot />
    <style is:global>
      :root {
        --light-background: #f1fcfd;
        --dark-background: #1f2937;

        --white: #f3f4f6;

        --black: #181823;
        --black-transparent-02: #1818234f;
        --black-transparent-08: #181823ec;
        --grey: #8199b4;

        --light-blue: #a6d1e6;
        --dark-blue: #06283d;

        --sky-blue: #c7eeff;
        --sky-blue-transparent: #c7eeff80;

        --max-width: 1330px;
        --border-radius: 1.875rem;

        --step--2: clamp(0.7813rem, 0.7747rem + 0.0326vw, 0.8rem);
        --step--1: clamp(0.95rem, 0.93rem + 0.12vw, 1.1rem);
        --step-0: clamp(1.125rem, 1.0815rem + 0.2174vw, 1.25rem);
        --step-1: clamp(1.35rem, 1.2761rem + 0.3696vw, 1.5625rem);
        --step-2: clamp(1.62rem, 1.5041rem + 0.5793vw, 1.9531rem);
        --step-3: clamp(1.9438rem, 1.7707rem + 0.8652vw, 2.4413rem);
        --step-4: clamp(2.3325rem, 2.0823rem + 1.2511vw, 3.0519rem);
        --step-5: clamp(2.7994rem, 2.4461rem + 1.7663vw, 3.815rem);

        --shadow-color: 199deg 40% 56%;
        --shadow-elevation-low:
          0px 0.9px 1.2px hsl(var(--shadow-color) / 0.22),
          0px 1.6px 2.1px -0.6px hsl(var(--shadow-color) / 0.35),
          0px 3.8px 5px -1.3px hsl(var(--shadow-color) / 0.48);
        --shadow-elevation-medium:
          0px 0.4px 0.5px hsl(var(--shadow-color) / 0.36),
          0px 1.5px 1.7px -0.8px hsl(var(--shadow-color) / 0.36),
          0px 3.7px 4.2px -1.7px hsl(var(--shadow-color) / 0.36),
          0px 8.9px 10px -2.5px hsl(var(--shadow-color) / 0.36);
        --shadow-elevation-high:
          0px 0.4px 0.5px hsl(var(--shadow-color) / 0.34),
          0px 2.6px 2.9px -0.4px hsl(var(--shadow-color) / 0.34),
          0px 4.9px 5.5px -0.7px hsl(var(--shadow-color) / 0.34),
          0px 8px 9px -1.1px hsl(var(--shadow-color) / 0.34),
          -0.1px 12.8px 14.4px -1.4px hsl(var(--shadow-color) / 0.34),
          -0.1px 19.9px 22.4px -1.8px hsl(var(--shadow-color) / 0.34),
          -0.1px 30.3px 34.1px -2.1px hsl(var(--shadow-color) / 0.34),
          -0.2px 44.7px 50.3px -2.5px hsl(var(--shadow-color) / 0.34);
      }

      [data-theme='dark'] {
        --light-background: #f1fcfd;
        --dark-background: #1f2937;

        --white: #f3f4f6;
        --black: #181823;
        --black-transparent-02: #1818234f;
        --black-transparent-08: #181823ec;
        --black-transparent-09: #181823f0;

        --light-blue: #a6d1e6;
        --dark-blue: #06283d;

        --sky-blue: #c7eeff;
        --sky-blue-transparent: #c7eeff80;

        .icon-sun {
          display: none;
        }

        .logo-light {
          display: none;
        }

        .icon-language-nav-light {
          display: none;
        }

        .icon-sun-nav {
          display: none;
        }

        .bento__9-img-light {
          display: none;
        }
      }

      [data-theme='light'] {
        --light-background: #1f2937;
        --dark-background: #f1fcfd;

        --white: #181823;
        --black: #f3f4f6;
        --black-transparent-02: #f3f4f62a;
        --black-transparent-08: #f3f4f6f5;
        --black-transparent-09: #f3f4f6f0;
        /* --grey (#8199b4) only reaches 2.8:1 on the light background; this
           shade keeps the same hue at 5.5:1 (WCAG 1.4.3) */
        --grey: #4f6782;

        --light-blue: #06283d;
        --dark-blue: #a6d1e6;

        --sky-blue: #c7eeff;
        --sky-blue-transparent: #c7eeff80;

        .icon-moon {
          display: none;
        }

        .logo-dark {
          display: none;
        }

        .icon-language-nav {
          display: none;
        }

        .icon-moon-nav {
          display: none;
        }

        .item {
          color: var(--light-blue);
        }

        .bento__9-img-dark {
          display: none;
        }
      }

      *,
      *:before,
      *:after {
        box-sizing: border-box;
        padding: 0;
        margin: 0;
      }

      html {
        font-family: 'Onest Variable', sans-serif;
        scroll-behavior: smooth;
        overflow-x: hidden;
        font-size: 16px;
      }

      .dark {
        color-scheme: dark;
      }

      body {
        background-color: var(--dark-background);
        color: var(--white);
        background-image: url('/noise/perlin.webp');
        background-repeat: repeat;
        background-size: 180px;
        z-index: -1;
        display: flex;
        flex-direction: column;
        align-items: center;
      }

      main {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 6.25rem;
        overflow: hidden;
      }

      img,
      video {
        max-width: 100%;
        height: auto;
      }

      ul {
        list-style: none;
      }

      header,
      section,
      footer {
        max-width: calc(var(--max-width) - 4rem);
        width: 100%;
        margin: 0 auto;
        padding: 0 2rem;
      }

      h2 {
        width: max-content;
        font-size: var(--step-2);
        font-weight: 600;
        text-transform: uppercase;
        border-bottom: 5px solid var(--sky-blue);
        box-shadow: 0 6px 3px -5px var(--sky-blue);

        display: flex;
        align-items: center;
        gap: 0.3rem;
      }

      h1,
      h2,
      h3,
      h4,
      h5,
      h6 {
        text-wrap: balance;
      }

      p {
        text-wrap: pretty;
      }

      ::-webkit-scrollbar {
        width: 10px;
      }
      ::-webkit-scrollbar-track {
        background: transparent;
        backdrop-filter: blur(10px);
        border-radius: 5px;
      }
      ::-webkit-scrollbar-thumb {
        background: var(--sky-blue-transparent);
        backdrop-filter: blur(10px);
        border-radius: 5px;
        border: 1px solid var(--dark-blue);
      }
      ::-webkit-scrollbar-thumb:hover {
        background: var(--sky-blue);
      }

      /* Accessibility */
      :focus-visible {
        /* --light-blue is inverted per theme, so it contrasts with the page
           background in both (>= 9:1) */
        outline: 3px solid var(--light-blue);
        outline-offset: 3px;
      }

      .sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        padding: 0;
        margin: -1px;
        overflow: hidden;
        clip: rect(0, 0, 0, 0);
        white-space: nowrap;
        border: 0;
      }

      .skip-link {
        position: fixed;
        top: 1rem;
        left: 1rem;
        z-index: 1000;
        padding: 0.75rem 1.25rem;
        background-color: var(--black);
        color: var(--white);
        border: 2px solid var(--light-blue);
        border-radius: var(--border-radius);
        font-weight: 600;
        text-decoration: none;
        transform: translateY(-200%);
      }

      .skip-link:focus {
        transform: none;
      }

      @media (prefers-reduced-motion: reduce) {
        html {
          scroll-behavior: auto;
        }

        *,
        *::before,
        *::after {
          animation-duration: 0.01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: 0.01ms !important;
        }

        /* Scroll-linked header/nav animations follow the user's own scrolling
           and are what shows or hides them, so they keep their timing */
        .header,
        .nav {
          animation-duration: auto !important;
        }
      }

      /* Scroll reveal (src/components/dom/reveal.js). Content starts hidden
         only when JS runs and motion is welcome: without JS, or with reduced
         motion, it is simply there. */
      @media (prefers-reduced-motion: no-preference) {
        html.js [data-reveal]:not([data-revealed]) {
          opacity: 0;
        }

        html.js [data-revealed] {
          animation-duration: 0.6s;
          animation-timing-function: cubic-bezier(0.16, 1, 0.3, 1);
          animation-delay: var(--reveal-delay, 0ms);
          /* backwards, not both: once finished, the element is back on its
             own styles, so hover transforms keep working */
          animation-fill-mode: backwards;
        }

        html.js [data-reveal='up'][data-revealed] {
          animation-name: reveal-up;
        }

        html.js [data-reveal='down'][data-revealed] {
          animation-name: reveal-down;
        }

        html.js [data-reveal='left'][data-revealed] {
          animation-name: reveal-left;
        }

        html.js [data-reveal='right'][data-revealed] {
          animation-name: reveal-right;
        }

        html.js [data-reveal='fade'][data-revealed] {
          animation-name: reveal-fade;
        }

        html.js [data-reveal='zoom'][data-revealed] {
          animation-name: reveal-zoom;
        }

        /* Revealed by keyboard focus: no motion under the reader's eyes.
           Same specificity as the rules above and declared after them, so
           it wins */
        html.js [data-reveal][data-revealed='instant'] {
          animation-name: none;
        }
      }

      /* `translate`/`scale` instead of `transform`, so the keyframes never
         fight a component's own transform (pick a variant whose property the
         element does not animate on hover: .icon__svg scales, so it uses up). Only `from`: the end state is the
         element's real style. left/right name the direction of the motion */
      @keyframes reveal-up {
        from {
          opacity: 0;
          translate: 0 1.5rem;
        }
      }

      @keyframes reveal-down {
        from {
          opacity: 0;
          translate: 0 -1.5rem;
        }
      }

      @keyframes reveal-left {
        from {
          opacity: 0;
          translate: 1.5rem 0;
        }
      }

      @keyframes reveal-right {
        from {
          opacity: 0;
          translate: -1.5rem 0;
        }
      }

      @keyframes reveal-fade {
        from {
          opacity: 0;
        }
      }

      @keyframes reveal-zoom {
        from {
          opacity: 0;
          scale: 0.92;
        }
      }

      @media print {
        html.js [data-reveal] {
          opacity: 1 !important;
          animation: none !important;
        }
      }
    </style>
  </body>
</html>
